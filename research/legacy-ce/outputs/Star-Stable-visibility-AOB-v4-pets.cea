    normal='83 FF 04'},
  horse={name='horse',symbol='SSOHideAOB4_Horse',branch=14,call=7,getter=21,setter=39,
    pattern='4C 8D BE ?? ?? ?? ?? E8 ?? ?? ?? ?? 84 C0 74 ?? 33 D2 48 8B CE E8 ?? ?? ?? ?? 25 FF FF FF F3 33 D2 44 8B C0 48 8B CE E8 ?? ?? ?? ?? F3 41 0F 10 0F',
    normal='83 FB 04'},
